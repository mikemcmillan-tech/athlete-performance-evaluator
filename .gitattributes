# Normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly LF for web files
*.html text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.py   text eol=lf

# Binary — no line ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.woff2 binary
*.woff  binary
